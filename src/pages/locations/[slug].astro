---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import EstimateCard from '../../components/EstimateCard.astro';
import Steps from '../../components/Steps.astro';
import { towns } from '../../data/towns';
import { pests } from '../../data/pests';
import { site } from '../../data/site';
import { u } from '../../lib/url';

export function getStaticPaths() {
  return towns.map((town) => ({ params: { slug: town.slug }, props: { town } }));
}

const { town } = Astro.props;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Pest Control', item: new URL(u(), site.url).href },
    { '@type': 'ListItem', position: 2, name: town.name, item: new URL(u(`locations/${town.slug}/`), site.url).href },
  ],
};
---

<Base
  title={`Professional Pest Control in ${town.name}, SC | Thuro Pest Control`}
  description={`Thuro Pest Control protects ${town.name}, SC homes with quarterly plans and one-time treatments. Family- and pet-friendly, licensed and insured. Free estimates.`}
  path={`locations/${town.slug}/`}
  jsonLd={[breadcrumbLd]}
  town={town}
>
  <section class="hero hero-sm">
    <div class="container hero-grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={u()}>Pest Control</a> / <span>{town.name}</span>
        </nav>
        <span class="eyebrow">Thuro Pest Control in {town.name}, SC</span>
        <h1>Professional Pest Control in {town.name}, SC</h1>
        <p class="lede">{town.blurb}</p>
        <ul class="hero-points">
          <li><Icon name="check" size={20} /> Licensed &amp; insured in South Carolina</li>
          <li><Icon name="check" size={20} /> Free re-treatment between visits</li>
          <li><Icon name="check" size={20} /> Family- and pet-friendly treatments</li>
        </ul>
        <a class="btn btn-gold" href={site.phoneHref}><Icon name="phone" size={18} /> Call {site.phone}</a>
      </div>
      <EstimateCard heading={`Free Estimate in ${town.name}`} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pests We Control</span>
        <h2>Pest protection for {town.name} homes</h2>
      </div>
      <div class="card-grid">
        {pests.map((p) => (
          <a class="card" href={u(`pests/${p.slug}/`)}>
            <span class="card-icon"><Icon name={p.icon} size={26} /></span>
            <h3>{p.name}</h3>
            <p>{p.short}</p>
            <span class="card-more">Learn more <Icon name="arrow-right" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How It Works</span>
        <h2>What to expect from Thuro</h2>
      </div>
      <Steps />
    </div>
  </section>
</Base>
