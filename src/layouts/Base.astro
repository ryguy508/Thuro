---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/playfair-display';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { towns, type Town } from '../data/towns';
import { u } from '../lib/url';
import Icon from '../components/Icon.astro';
// The two fonts every page uses above the fold; preloading them avoids a flash of fallback text.
import montserratLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import playfairLatin from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Path under the base, e.g. "pests/ants/". Empty string is the home page. */
  path?: string;
  /** Extra JSON-LD objects (FAQ, breadcrumbs, ...). */
  jsonLd?: object[];
  /** Set on location pages. Brands the header and structured data as "Thuro Pest Control in {town}". */
  town?: Town;
  /** Keeps utility pages such as the 404 out of search results. */
  noindex?: boolean;
}

const { title, description, path = '', jsonLd = [], town, noindex = false } = Astro.props;
const canonical = new URL(u(path), site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: town ? `${site.name} in ${town.name}` : site.name,
  url: new URL(u(path), site.url).href,
  telephone: site.phoneE164,
  description: 'Residential pest control, quarterly protection plans, and one-time treatments.',
  areaServed: (town ? [town] : towns).map((t) => ({ '@type': 'City', name: `${t.name}, SC` })),
  parentOrganization: { '@type': 'Organization', name: site.parent, url: site.mainSite },
  address: { '@type': 'PostalAddress', addressLocality: 'Conway', addressRegion: 'SC', postalCode: '29526', addressCountry: 'US' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#101010" />
    <link rel="preload" as="font" type="font/woff2" href={montserratLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={playfairLatin} crossorigin />
    <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(u('brand/thuro-exteriors-logo.png'), site.url).href} />
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href={u('sitemap-index.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header town={town} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* Phones only: keeps the two main actions one tap away while scrolling. */}
    <div class="sticky-cta" data-sticky-cta hidden>
      <a class="btn btn-outline" href={site.phoneHref}><Icon name="phone" size={18} /> Call</a>
      <a class="btn btn-gold" href="#estimate">Free Estimate</a>
    </div>
    <script>
      const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
      const card = document.getElementById('estimate');
      if (bar && card) {
        bar.hidden = false;
        // Hidden while the estimate card is on screen, so it never covers the form.
        new IntersectionObserver(([entry]) => bar.classList.toggle('is-visible', !entry.isIntersecting)).observe(card);
      }
    </script>
  </body>
</html>
